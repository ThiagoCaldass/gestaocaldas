{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/mcp/([^/]+)",
      "dest": "/api/mcp?chave=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/jiujitsu.html",
      "dest": "/jiujitsu.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/analise.js": {
      "maxDuration": 300
    }
  }
}
